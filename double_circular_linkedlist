#include<iostream>
using namespace std;
struct node{
	int data;
	node* prev;
	node* next;
	node(int value){
		data=value;
		next=NULL;
		prev=NULL;
	}
};
class doublecircularlist{
	private:
		node* head;
	public:
		doublecircularlist(){
			head=NULL;
		}
		void insertatbegin(int value){
			node* newnode=new node(value);
			if(head==NULL){
				head=newnode;
				newnode->prev=head;
				newnode->next=head;
				return;
				
			}
			newnode->prev=head->prev;
			newnode->next=head;
			head=newnode;
		}
		void insertend(int value){
			node* newnode=new node(value);
			if(head==NULL){
				head=newnode;
				newnode->prev=head;
				newnode->next=head;
				return;
			}
			head->prev->next=newnode;
			newnode->prev=head->prev;
			newnode->next=head;
		}
		void display(){
			if(head==NULL){
				cout<<"list empty\n";
				return;
			}
			node* temp=head;
			do{
				cout<<temp->data<<"<->";
				temp=temp->next;
			}while(temp!=head);
			cout<<"head";
		}
		
};
int main(){
	doublecircularlist c1;
	c1.insertatbegin(10);
	c1.insertend(20);
	c1.display();
	return 0;
}
