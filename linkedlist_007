#include <iostream>
using namespace std;
struct node{
	int data;
	node* next;
};
class linkedlist{
	private:
	 node* head;
	public:
		linkedlist(){
			head=NULL;
		}
		void insertion_beginning(int value){
			node* newnode=new node();
			newnode->data=value;
			newnode->next=head;
			head=newnode;
		}
		void display(){
			if(head==NULL){
				cout<<"the list is empty";
				return;
			}
			node* temp=head;
			while(temp!=NULL){
				cout<<temp->data<<"->";
				temp=temp->next;
			}
			cout<<"null";
		}
		void insert_at_position(int value,int position){
			node* newnode=new node();
			newnode->data=value;
			if(position==1){
				newnode->next=head;
				head=newnode;
				return;
			}
			node* temp=head;
			for(int i=1;i<position-1;i++){
				temp=temp->next;
				
			}
			newnode->next=temp->next;
			temp->next=newnode;
			display();
			
			
		}
		void deleting_value(int value){
			if(head==NULL){
				cout<<"LIST IS EMPTY\n";
				return;
			}
			if(head->data==value){
				node* temp=head;
				head=head->next;
				delete temp;
				return;
			}
			node* temp=head;
			node* prev=NULL;
			while(temp!=NULL && temp->data!=value){
				prev=temp;
				temp=temp->next;
			}
			if(temp==NULL){
				cout<<"not found in list\n";
				return;
			}
			prev->next=temp->next;
			delete temp;
			
		}
		
		void delete_all_begin(){
			if(head==NULL){
				cout<<"list is empty\n";
				return;
			}
			node* temp;
			while(head!=NULL){
				temp=head;
				head=head->next;
				delete temp;
				node* prev=head;
				while(prev!=NULL){
					cout<<prev->data<<"->";
					prev=prev->next;
				}
				cout<<"null";
			}
		}
		int sum_duplicate(){
    if(head==NULL){
        cout<"sum is 0";
        return;
    }
    node* temp=head;
    int sum=0;
    while(temp!=NULL){
        node* prev=NULL;
        node* current=head;
        while(current!=NULL){
            if(temp->data==current->data){
                sum+=current->data;
                prev->next=current->next;
                delete current;
                break;
                
            }
            prev=current;
            current=current->next;
        }
        temp=temp->next;
        
        
    }
  return sum;
}
	    void reverse(){
	    	if(head==NULL){
	    		cout<<"the list is empty\n";
	    		return;
			}
			node* prev=NULL;
			node* current=head;
			node* next=NULL;
			while(current!=NULL){
				next=current->next;
				current->next=prev;
				prev=current;
				current=next;
			}
			head=prev;
		}
};
int main(){
	linkedlist l1;
	for(int i=1;i<=6;i++){
		int x;
		cout<<"enter\n";
		cin>>x;
		l1.insertion_beginning(x);
	}
	l1.insert_at_position(30,4);
	l1.deleting_value(20);
	l1.display();
	l1.reverse();
	l1.display();
	l1.sum_duplicate();
	l1.delete_all_begin();
	return 0;
	
	
}
