#include <iostream>
using namespace std;

int main() {
    int nodes = 4;
    // Create a 4x4 grid filled with 0
    int matrix[4][4] = {0};

    // Add an edge between Node 0 and Node 1
    matrix[0][1] = 1;
    matrix[1][0] = 1;

    // Add an edge between Node 1 and Node 2
    matrix[1][2] = 1;
    matrix[2][1] = 1;

    cout << "Adjacency Matrix (The Graph Grid):" << endl;
    for (int i = 0; i < nodes; i++) {
        for (int j = 0; j < nodes; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
