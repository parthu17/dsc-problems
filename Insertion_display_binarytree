#include<iostream>
using namespace std;
class node{
public:
 int data;
 node* left;
 node* right;
 node(int value){
   data=value;
   left=NULL;
   right=NULL;
};
class binarytree{
public:
 node* root;
 binarytree() {
  root=NULL;
}
node* insertatleft(node* parent,int value){
 parent->left=new node(value);
 return parent->left;
}
node* insertatright(node* parent,int value){
 parent->right=new node(value);
 return parent->right;
}
void inorder(node* root){
if(root!=NULL){
 inorder(root.left);
 cout<<root->data<<"->";
 inorder(root.right);
}
}
void preorder(node* root){
if(root!=NULL){
 cout<<root->data<<"->";
 preorder(root->left);
 preorder(root->right);
}
}
void postorder(node* root){
if(root!=NULL){
 postorder(root->left);
 postorder(root->right);
 cout<<root->data<<"->";
}
}
};
int main(){
binarytree b1;
b1.root= new node(10);
node* left=b1.insertatleft(b1.root,20);
