#include <iostream>
using namespace std;

int main() {
    int nodes = 4;
    // Create a 4x4 grid filled with 0
    int matrix[4][4] = {0};

    // Add an edge between Node 0 and Node 1
    matrix[0][1] = 1;
    matrix[1][0] = 1;

    // Add an edge between Node 1 and Node 2
    matrix[1][2] = 1;
    matrix[2][1] = 1;

    cout << "Adjacency Matrix (The Graph Grid):" << endl;
    for (int i = 0; i < nodes; i++) {
        for (int j = 0; j < nodes; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
Heaps
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

void heapify(vector<int>& arr, int n, int i) {
    int largest = i; 
    int left = 2 * i + 1; 
    int right = 2 * i + 2; 

    // If left child is larger than root
    if (left < n && arr[left] > arr[largest])
        largest = left;

    // If right child is larger than largest so far
    if (right < n && arr[right] > arr[largest])
        largest = right;

    // If largest is not root, swap and keep fixing
    if (largest != i) {
        swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}

int main() {
    vector<int> arr = {12, 11, 13, 5, 6, 7};
    int n = arr.size();

    // Turn unsorted array into a Max Heap
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(arr, n, i);

    cout << "Max Heap array: ";
    for (int i : arr) cout << i << " ";
    return 0;
} 
