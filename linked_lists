#include <iostream>
using namespace std;
struct node{
	int data;
	node* next;
};
class linkedlist{
	private:
		node* head;
	public:
		linkedlist(){
			head= NULL;
		}
		void insertatbeginning(int value){
			node* newnode= new node();
			newnode->data=value;
			newnode->next=head;
			head=newnode;
		}
		void insertatend(int value){
			node* newnode=new node();
			newnode->data=value;
			newnode->next=NULL;
			if(head==NULL){
				head=newnode;
				return;
			}
			node* temp=head;
			while(temp->next!=NULL){
				temp=temp->next;
			}
			temp->next=newnode;
		}
		void display(){
			if(head==NULL){
				cout<<"null";
				return;
			}
			node* temp=head;
			while(temp!=NULL){
				cout<<temp->data<<" ->";
				temp=temp->next;
			}
			cout<<"null";
			
		}
        node* second(){
          node* temp=head;
          node* head2=NULL;
          while(temp!=NULL){
            node* newnode=new node();
            newnode->data=2*(temp->data);
            newnode->next=head2;
            head2=newnode;
            temp=temp->next;
     }}
       void reverse_half(){
    if(head==NULL){
        cout<"list is empty";
        return;
    }
    node* temp=head;
    int n=0;
    while(temp!=NULL){
        temp=temp->next;
        n++;
    }
    int half=n/2;
    node* prev=NULL;
    node* current=head;
    node* next=NULL;
    
    while(half-- >0){
        next=current->next;
        current->next =prev;
        prev=current;
        current=next;
        
    }
    

 
}
void reverse_element(int value){
    if(head==NULL){
        cout<<"list empty";
        return;
    }
    if(head->data==value){
        cout<<"reversed already";
        return;
    }
    node* prev=NULL;
    node* current=head;
    node* next=NULL;
    while(current->data!=value){
        next=current->next;
        current->next =prev;
        prev=current;
        current=next;
    }
}
		~linkedlist(){
			node* temp;
			while(head!=NULL){
				temp=head;
				head=head->next;
				delete temp;
			}
		}
		
};
