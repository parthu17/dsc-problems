#include<iostream>
using namespace std;
#define MAX 100
class stackinterface{
	public:
		virtual void push(int n)=0;
		virtual void pop()=0;
		virtual void peek()=0;
		virtual void display()=0;
		virtual bool isEmpty()=0;
		virtual bool isFull()=0;
		
};
class stack:public stackinterface{
	private:
		int a[MAX];
		int top;
	public:
		stack(){
			top=-1;
		}
		bool isEmpty(){
			return top<0;
		}
		bool isFull(){
			return top>=MAX-1;
		}
		void push(int n) override{
			if(isFull()){
				cout<<"stack overflow\n";
				return;
			}
			a[++top]=n;
		}
		void pop() override{
			if(isEmpty()){
				cout<<"stack underflow\n";
				return;
			}
			cout<<a[top--]<<" element was removed from stack\n";
			
		}
		void peek() override{
			if(isEmpty()){
				cout<<"stack is empty\n";
				return;
			}
			cout<<a[top]<<" is the top element of the stack\n";
		}
		void display(){
			if(isEmpty()){
				cout<<"stack is empty\n";
				return;
			}
			for(int i=top;i>=0;i--){
				cout<<a[i]<<" ";
			}
			cout<<endl;
		}
		
};
int main(){
	stack s1;
	s1.push(2);
	s1.push(3);
	s1.pop();
	s1.peek();
	s1.display();
	return 0;
	}
