#include <iostream>
using namespace std;
void swap(int &a,int &b){
	int temp;
	temp=a;
	a=b;
	b=temp;
}
void selection(int a[],int n){
	for(int i=0;i<n-1;i++){
		int min=i;
		for(int j=i;j<n;j++){
			if(a[j]<=a[min]){
				min=j;
			}
		}
		if(min!=i){
			swap(a[i],a[min]);
		}
	}
}
int main(){
	int a[10]={23,23,345,342,534,2333,343,23,34,23};
	int n = sizeof(a)/sizeof(a[0]);
	selection(a,n);
	for(int i=0;i<n;i++){
		cout<<a[i]<<" ";
	}
}
