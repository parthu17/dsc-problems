#include<iostream>
using namespace std;
#define MAX 100
class stack{
  public:
  	int a[MAX];
  	int top;
  stack(){
  	top=-1;
  	
  }
  void push(int n){
  	if(top>=MAX-1){
  		cout<<"stack overflow\n";
  		return;
	  }
	  a[++top]=n;
	  
  }
  void pop(){
  	if(top<0){
  		cout<<"stack underflow\n";
  		return;
	  }
	  cout<<a[top--]<<" has been removed from stack\n";
	  
  }
  void peek(){
  	if(top<0){
  		cout<<"stack is empty\n";
  		return;
	  }
	 cout<<a[top]<<" is the top element\n";
  }
  void display(){
  	if(top<0){
  		cout<<"stack is empty\n";
  		return;
	  }
	  for(int i=top;i>=0;i--){
	  	cout<<a[i]<<" ";
	  }
	  cout<<"stack end"<<endl;
  }
};
int main(){
	stack s1,s2;
	s1.push(1);
	s1.push(2);
	s1.push(3);
	s1.push(4);
	s1.push(5);
	s1.pop();
	s2.push(1);
	s2.push(2);
	s2.push(3);
	s2.push(4);
	s2.push(5);
	s2.pop();
	int i;
	for(i=s1.top;i>=0;i--){
		if(s1.a[i]!=s2.a[i]){
			cout<<"not equal stacks\n";
			break;
		}
	}
	if(i==-1){
		cout<<"equal stacks\n";
		
	}
	s1.peek();
	s1.display();
	s2.peek();
	s2.display();
	return 0;
}
