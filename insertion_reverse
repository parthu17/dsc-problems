#include<iostream>
using namespace std;
void insertion(int a[],int n){
for(int i=0;i<n;i++){
int key=a[i];
j=i+1;
while(i>=0 && a[j]<key){
a[j-1]=a[j];
i=i-1;
}
a[j+1]=key;
}
}
int main(){
int a[5]={2,4,6,5,3};
int n = sizeof(a)/sizeof(a[0];
insertion(a,n);
for(int i=0;i<n;i++){
cout<<a[i]<<" ";
}
return 0;
}
